{
  "name": "vocoder-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vocoder-i18n/sdk.git"
  },
  "homepage": "https://github.com/vocoder-i18n/sdk#readme",
  "bugs": {
    "url": "https://github.com/vocoder-i18n/sdk/issues"
  },
  "packageManager": "pnpm@10.29.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "dev": "pnpm run watch:all",
    "watch": "pnpm run watch:all",
    "watch:react": "pnpm --dir packages/react watch",
    "watch:cli": "pnpm --dir packages/cli watch",
    "watch:all": "concurrently \"pnpm watch:react\" \"pnpm watch:cli\"",
    "lint": "biome lint ./packages ./scripts",
    "lint:write": "biome lint --write ./packages ./scripts",
    "format": "biome format ./packages ./scripts",
    "format:write": "biome format --write ./packages ./scripts",
    "check": "biome check ./packages ./scripts",
    "check:write": "biome check --write ./packages ./scripts",
    "clean": "pnpm -r --if-present run clean",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "release": "changeset publish",
    "prepublishOnly": "pnpm run build",
    "clean:all": "pnpm run clean && find . -name 'node_modules' -type d -exec rm -rf {} + 2>/dev/null || true && pnpm install && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@changesets/cli": "^2.26.2",
    "@types/node": "^20.19.9",
    "concurrently": "^9.2.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
